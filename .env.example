# .env.example — Copy thành .env khi chạy local
# Trên Render: vào Settings → Environment → thêm từng biến bên dưới

# ── Database (PostgreSQL do Render cấp) ───────────
# Dùng Internal Database URL (không cần sslmode)
DATABASE_URL=postgresql://user:password@host/dbname

# ——— Telegram (Thông báo cảnh báo) ————————————————
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Email báo cáo tuần ────────────────────────────
# Gmail: bật 2FA → tạo App Password tại myaccount.google.com/apppasswords
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENT=recipient@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Ngưỡng cảnh báo sensor (giá trị mặc định, có thể override) ──
TEMP_MIN=15
TEMP_MAX=35
SOIL_MIN=40
SOIL_MAX=70
LIGHT_MIN=500
