# .env.example — Copy thành .env khi chạy local
# Trên Railway: vào Settings → Variables → thêm từng dòng

# ── Database ──────────────────────────────────────
DB_PATH=cai_ngot.db

# ── ESMS.vn (SMS cảnh báo) ────────────────────────
# Đăng ký tại: https://esms.vn
ESMS_API_KEY=your_api_key_here
ESMS_SECRET_KEY=your_secret_key_here
ESMS_BRANDNAME=Baotrixemay
SMS_PHONE=0901234567

# ── Email báo cáo tuần ────────────────────────────
# Gmail: bật 2FA → tạo App Password tại myaccount.google.com/apppasswords
EMAIL_SENDER=your_gmail@gmail.com
EMAIL_PASSWORD=abcd efgh ijkl mnop
EMAIL_RECIPIENT=recipient@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Ngưỡng cảnh báo sensor ────────────────────────
TEMP_MIN=15
TEMP_MAX=35
SOIL_MIN=40
LIGHT_MIN=500
